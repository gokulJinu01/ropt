# ROBOPET SETUP — fill the USER fields when you are ready.
# This file works as a no-cost demo without any keys.
# Do not commit real credentials. Shell environment variables override this file.

PET_NAME=Pip
PET_PET_ID=my-pet
PET_PERSONALITY="warm, curious, a little goofy"
PET_LANGUAGE=English

# USER: switch these three to deepgram / claude / cartesia for real voice.
PET_MODE=pet
PET_STT=echo
PET_LLM=scripted
PET_TTS=beep

# USER: private service credentials. Leave blank until configured.
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# USER: model supported by your AI account, and a Cartesia voice ID.
PET_CLAUDE_MODEL=REPLACE_WITH_SUPPORTED_MODEL_ID
PET_CARTESIA_VOICE_ID=REPLACE_WITH_VOICE_ID
# USER: only change this for an intentional Anthropic-compatible proxy.
PET_ANTHROPIC_BASE_URL=https://api.anthropic.com
PET_DEEPGRAM_MODEL=nova-2
PET_STT_LANGUAGE=en-US
PET_CARTESIA_MODEL=sonic-3.6

# USER: choose a daily cloud request allowance (0 prevents paid operation).
# These count attempts, including failed calls. Set dollar limits at providers.
PET_MAX_CLOUD_TURNS_PER_DAY=0
PET_MAX_TURNS_PER_HOUR=120

# Local memory works immediately. It is a simple journal, not MME.
# USER: fill mme-config.json, then change local to mme to enable actual MME.
PET_MEMORY=local
MME_API_KEY=
PET_MEMORY_TOKEN_BUDGET=400
PET_MEMORY_TIMEOUT_S=5

# Optional tuning: the pet answers briefly, then returns to quiet companionship.
PET_LISTENING_TIMEOUT_S=15
PET_TURN_TIMEOUT_S=30
PET_PLAYED_TIMEOUT_S=30
PET_IDLE_LOW_S=20
PET_IDLE_HIGH_S=60
PET_GOODBYE_QUIET_S=300
PET_MAX_REPLY_SENTENCES=2
PET_MAX_REPLY_CHARS=400
